# BitGet API credentials (only needed when PAPER_TRADING=false)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com

# Trading mode: "spot" or "futures"
TRADE_MODE=spot

# Portfolio value — used to calculate position size
PORTFOLIO_VALUE_USD=1000

# Trade limits
MAX_TRADE_SIZE_USD=100
MAX_TRADES_PER_DAY=3

# Symbol and entry timeframe (monthly/weekly/daily always fetched for HTF bias)
SYMBOL=BTCUSDT
TIMEFRAME=4H

# Paper trading — set to "false" only when you're ready to place real orders
PAPER_TRADING=true

# ─── Multi-TF Pullback strategy ──────────────────────────────────────────

# Tolerance for "price touched EMA9-15 zone" check (0.5% is recommended for 4H)
PULLBACK_TOLERANCE_PCT=0.5

# ─── Visual confirmation (Gemini) ────────────────────────────────────────

# Turn off if you want the numeric layer only
USE_VISUAL_CONFIRMATION=true

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini model to use. gemini-2.5-flash is cheap + fast + vision-capable.
VISUAL_MODEL=gemini-2.5-flash

# Minimum score Gemini has to give (0-10) to pass the visual gate
MIN_LLM_SCORE=7

# Daily cost cap — bot stops calling Gemini once today's LLM spend exceeds this
MAX_LLM_SPEND_USD_PER_DAY=2
