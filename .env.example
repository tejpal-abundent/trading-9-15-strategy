# BitGet API credentials (only needed when PAPER_TRADING=false)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=
BITGET_BASE_URL=https://api.bitget.com

# Trading mode: "spot" or "futures"
TRADE_MODE=spot

# Portfolio value — used to calculate position size
PORTFOLIO_VALUE_USD=1000

# Trade limits
MAX_TRADE_SIZE_USD=100
MAX_TRADES_PER_DAY=3

# Symbol and entry timeframe (monthly/weekly/daily always fetched for HTF bias)
SYMBOL=BTCUSDT
TIMEFRAME=4H

# Paper trading — set to "false" only when you're ready to place real orders
PAPER_TRADING=true

# ─── Multi-TF Pullback strategy ──────────────────────────────────────────

# Tolerance for "price touched EMA9-15 zone" check (0.5% is recommended for 4H)
PULLBACK_TOLERANCE_PCT=0.5

# ─── Visual confirmation (Gemini) ────────────────────────────────────────

# Turn off if you want the numeric layer only
USE_VISUAL_CONFIRMATION=true

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Per-stage Gemini model selection. Defaults below are the recommended
# two-tier strategy as of Apr 2026: Pro for high-stakes HTF bias decisions,
# Flash for cheaper LTF entry confirmation.
#
#   HTF stage (1M/1W/1D bias)  → gemini-3.1-pro-preview  (~$0.0056/call, best chart vision)
#   LTF stage (4H/2H/1H entry) → gemini-3-flash-preview  (~$0.0014/call, next-gen Flash)
#
# Set VISUAL_MODEL alone to force one model for both stages.
HTF_MODEL=gemini-3.1-pro-preview
LTF_MODEL=gemini-3-flash-preview
# VISUAL_MODEL=gemini-2.5-flash

# Minimum score Gemini has to give (0-10) to pass the visual gate
MIN_LLM_SCORE=7

# Daily cost cap — bot stops calling Gemini once today's LLM spend exceeds this
MAX_LLM_SPEND_USD_PER_DAY=2

# ─── Daily email report (cron) ──────────────────────────────────────────
# Required only if you use scripts/daily-scan-email.js.
# Gmail users: generate an app password at
#   https://myaccount.google.com/apppasswords
# — regular passwords will NOT work with 2FA enabled.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASS=your-16-char-google-app-password
EMAIL_FROM=your-sender@gmail.com
EMAIL_TO=thetajas@gmail.com
